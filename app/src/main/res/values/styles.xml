<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 1) Tema de splash nativo (API 31+). -->
    <style name="Theme.SWADEbuilder" parent="Theme.SplashScreen">

        <!-- Fundo do splash: usa a mesma cor de pergaminho do app -->
        <item name="windowSplashScreenBackground">@color/pergaminho_fundo</item>

        <!-- Drawable com o logo centralizado -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/swade_splash_logo_img</item>

        <!-- Sem círculo colorido por trás do ícone -->
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <!-- Após o splash, aplica este tema base na MainActivity -->
        <item name="postSplashScreenTheme">@style/Theme.SWADEbuilder.NoSplash</item>

        <!-- CORES LEGADAS (pra não dar erro em attrs antigos) -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- 2) Tema “real” do app, sem action bar -->
    <style name="Theme.SWADEbuilder.NoSplash" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Fundo da janela (pergaminho claro do app) -->
        <item name="android:windowBackground">@android:color/background_light</item>

        <!-- Fundo padrão das views -->
        <item name="android:colorBackground">@color/pergaminho_fundo</item>

        <!-- Texto escuro -->
        <item name="android:textColorPrimary">@android:color/black</item>

    </style>

    <!-- (Opcional) Tema para alguma Activity de detalhe -->
    <style name="Theme.DetalheActivity" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/pergaminho_fundo</item>
        <item name="android:colorBackground">@color/pergaminho_fundo</item>
        <item name="android:textColorPrimary">@android:color/black</item>
    </style>

</resources>
