{
  "version": 1,
  "title": "Plano de execução completo - traits raciais tipados",
  "goal": "Migrar de heurísticas por texto para modelo tipado com variantes declarativas e alta confiabilidade",
  "phases": [
    {
      "id": "P1",
      "name": "Fundação de dados",
      "status": "completed",
      "deliverables": [
        "docs/racial_trait_catalog_seed.json",
        "docs/racial_trait_schema_v1.json"
      ],
      "checks": [
        "Schema JSON válido",
        "Seed JSON válido"
      ]
    },
    {
      "id": "P2",
      "name": "Plano de migração",
      "status": "completed",
      "deliverables": [
        "docs/racial_trait_migration_plan.md"
      ],
      "checks": [
        "PRs em fases definidas",
        "Critérios de aceite definidos",
        "Matriz de testes definida"
      ]
    },
    {
      "id": "P3",
      "name": "Registro no app",
      "status": "completed",
      "deliverables": [
        "app/src/main/assets/racial_trait_execution_plan_v1.json"
      ],
      "checks": [
        "Plano serializado em asset versionado"
      ]
