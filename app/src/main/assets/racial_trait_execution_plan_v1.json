      ],
      "checks": [
        "Seed contém traits críticos de variante",
        "Schema e seed parseáveis",
        "Plano de execução marcado como concluído"
      ]
    }
  ],
  "critical_trait_ids": [
    "ADAPTAVEL",
    "AQUATICO",
    "SEMIAQUATICO",
    "RESISTENCIA",
    "FRAGIL",
    "NAO_SABE_NADAR",
    "FORMA_ALIENIGENA",
    "COMUNITARIO",
    "TRANSTORNO_DE_SEPARACAO",
    "DESASTRADO"
  ]
